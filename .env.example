# 设置为 1 时要求 Apple Speech 尽量使用本机识别；具体支持取决于 macOS 和语言资源。
AI_INTERVIEW_MACOS_SPEECH_ON_DEVICE=0
AI_INTERVIEW_MACOS_SPEECH_TIMEOUT=12

